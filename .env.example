# Copy to .env.local for local dev. Set the same vars in Vercel/hosting — never commit real values.

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Finnhub (free tier)
FINNHUB_API_KEY=

# Financial Modeling Prep (free tier — analyst price targets, 250 calls/day)
FMP_API_KEY=

# Eulerpool (free tier — analyst price targets when FMP empty, 1,000 calls/month)
EULERPOOL_API_KEY=

# Cron auth: Authorization: Bearer … on /api/cron/refresh-targets
CRON_SECRET=

# Resend (optional — weekly Top Picks accuracy email; recipient defaults in code)
RESEND_API_KEY=

# Google Gemini (optional — picks/portfolio/watchlist narratives)
GEMINI_API_KEY=

# Twilio WhatsApp (optional — daily portfolio briefing at 7pm IST Mon–Fri)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: run migrations via npm run migrate or /api/setup/migrate (dev only)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@...pooler.supabase.com:6543/postgres
